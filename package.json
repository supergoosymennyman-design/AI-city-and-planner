{
  "name": "ai-education-shrink",
  "private": true,
  "scripts": {
    "setup": "npx impeccable skills install && npx impeccable init",
    "detect": "npx impeccable detect games/",
    "check:k3": "node tests/check-k3.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:content": "node scripts/validate-programme-content.mjs",
    "test:library": "cd \"P5 Programme\" && node scripts/library-audit.mjs",
    "preflight:commercial-vehicles": "cd \"P5 Programme\" && node scripts/commercial-vehicle-preflight.mjs",
    "test:imports": "cd \"P5 Programme\" && node scripts/check-imports.mjs",
    "preview:city": "node \"P5 Programme/tests/e2e/static-server.mjs\" 8377",
    "demo:prepare": "bash \"P5 Programme/deploy/scripts/deploy-city-apps.sh\" --build-only --city-sim",
    "demo:start": "node \"P5 Programme/scripts/demo-server.mjs\"",
    "demo": "npm run demo:prepare && npm run demo:start",
    "demo:reset": "node \"P5 Programme/scripts/demo-server.mjs\" --reset-only",
    "build:city": "bash \"P5 Programme/deploy/scripts/deploy-city-apps.sh\" --build-only --city-sim",
    "test:e2e": "bash \"P5 Programme/deploy/scripts/deploy-city-apps.sh\" --build-only --city-sim && E2E_DOCROOT=\"P5 Programme/deploy/city-sim\" node \"P5 Programme/tests/e2e/run-sharded.mjs\"",
    "test:e2e:source": "node \"P5 Programme/tests/e2e/run-sharded.mjs\"",
    "test:e2e:built": "E2E_DOCROOT=\"P5 Programme/deploy/city-sim\" node \"P5 Programme/tests/e2e/run-sharded.mjs\"",
    "deploy:city:built": "bash \"P5 Programme/deploy/scripts/deploy-city-apps.sh\" --deploy-only --city-sim",
    "test:all": "npm run test:unit && npm run test:library && npm run test:e2e:source && npm run test:imports",
    "release:city": "npm run test:all && npm run build:city && npm run test:unit && npm run test:library && npm run test:e2e:built && npm run deploy:city:built"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "impeccable": "^2.3.2"
  },
  "dependencies": {
    "@playwright/test": "^1.60.0"
  }
}
