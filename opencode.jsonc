{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp", "--browser", "chromium"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "ui-color-palette": {
      "type": "local",
      "command": ["npx", "-y", "supergateway", "--streamableHttp", "https://mcp-uicp.yelbolt.workers.dev/mcp"],
      "enabled": false
    },
    "stock-researcher": {
      "type": "local",
      "command": ["node", "/Users/kai/Documents/stocks-research/mcp/index.js"],
      "enabled": true
    },
    "tavily": {
      "type": "local",
      "command": ["npx", "-y", "tavily-mcp"],
      "enabled": true
    }
  }
}
