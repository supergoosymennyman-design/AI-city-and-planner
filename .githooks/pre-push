#!/usr/bin/env sh
# Pre-push gate (plan §7/§8): run `npm run validate` before any push, for EVERY dev,
# on EVERY editor/agent. This is the tool-agnostic local mirror of CI — it shortens the
# feedback loop so failures are caught before they reach a PR. CI is still the hard gate;
# this hook is a convenience, not a substitute.
#
# Installed via `git config core.hooksPath .githooks`, which `npm install` runs for you
# (scripts/setup-hooks.mjs, wired through the "prepare" script).
#
# Genuine emergency bypass: `git push --no-verify` (use sparingly — CI will still fail).

set -e

echo "[pre-push] running: npm run validate"
npm run validate
echo "[pre-push] ✓ validate passed — proceeding with push"
